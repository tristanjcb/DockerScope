{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["**/dist/**", "coverage/**", "node_modules/**", ".turbo/**"],
  "env": {
    "node": true
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "env": {
        "vitest": true
      }
    }
  ]
}
